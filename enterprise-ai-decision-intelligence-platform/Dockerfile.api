FROM python:3.14-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY src ./src
COPY train.py app.py alembic.ini ./
COPY migrations ./migrations
COPY artifacts ./artifacts

EXPOSE 8000
CMD ["sh", "-c", "alembic upgrade head && python -m src.database.load_synthetic_data && uvicorn src.api.main:app --host 0.0.0.0 --port 8000"]
